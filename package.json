{
    "name": "@beforesemicolon/intl",
    "version": "0.4.0",
    "description": "Web component localization based on Markup",
    "type": "module",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js",
            "default": "./dist/cjs/index.js"
        },
        "./runtime": {
            "types": "./dist/types/runtime.d.ts",
            "import": "./dist/esm/runtime.js",
            "require": "./dist/cjs/runtime.js",
            "default": "./dist/cjs/runtime.js"
        },
        "./formatters": {
            "types": "./dist/types/formatters.d.ts",
            "import": "./dist/esm/formatters.js",
            "require": "./dist/cjs/formatters.js",
            "default": "./dist/cjs/formatters.js"
        },
        "./components/intl-locale": {
            "types": "./dist/types/components/intl-locale.d.ts",
            "import": "./dist/esm/components/intl-locale.js",
            "require": "./dist/cjs/components/intl-locale.js",
            "default": "./dist/cjs/components/intl-locale.js"
        },
        "./components/intl-msg": {
            "types": "./dist/types/components/intl-msg.d.ts",
            "import": "./dist/esm/components/intl-msg.js",
            "require": "./dist/cjs/components/intl-msg.js",
            "default": "./dist/cjs/components/intl-msg.js"
        },
        "./components/intl-number": {
            "types": "./dist/types/components/intl-number.d.ts",
            "import": "./dist/esm/components/intl-number.js",
            "require": "./dist/cjs/components/intl-number.js",
            "default": "./dist/cjs/components/intl-number.js"
        },
        "./components/intl-datetime": {
            "types": "./dist/types/components/intl-datetime.d.ts",
            "import": "./dist/esm/components/intl-datetime.js",
            "require": "./dist/cjs/components/intl-datetime.js",
            "default": "./dist/cjs/components/intl-datetime.js"
        },
        "./components/intl-duration": {
            "types": "./dist/types/components/intl-duration.d.ts",
            "import": "./dist/esm/components/intl-duration.js",
            "require": "./dist/cjs/components/intl-duration.js",
            "default": "./dist/cjs/components/intl-duration.js"
        },
        "./components/intl-rel-time": {
            "types": "./dist/types/components/intl-rel-time.d.ts",
            "import": "./dist/esm/components/intl-rel-time.js",
            "require": "./dist/cjs/components/intl-rel-time.js",
            "default": "./dist/cjs/components/intl-rel-time.js"
        },
        "./components/intl-list": {
            "types": "./dist/types/components/intl-list.d.ts",
            "import": "./dist/esm/components/intl-list.js",
            "require": "./dist/cjs/components/intl-list.js",
            "default": "./dist/cjs/components/intl-list.js"
        },
        "./components/intl-name": {
            "types": "./dist/types/components/intl-name.d.ts",
            "import": "./dist/esm/components/intl-name.js",
            "require": "./dist/cjs/components/intl-name.js",
            "default": "./dist/cjs/components/intl-name.js"
        },
        "./components/intl-plural": {
            "types": "./dist/types/components/intl-plural.d.ts",
            "import": "./dist/esm/components/intl-plural.js",
            "require": "./dist/cjs/components/intl-plural.js",
            "default": "./dist/cjs/components/intl-plural.js"
        }
    },
    "scripts": {
        "lint": "eslint ./src && prettier --check ./src",
        "format": "eslint ./src --fix && prettier --write ./src",
        "test": "jest --config jest.config.cjs --coverage",
        "test:watch": "jest --config jest.config.cjs --watch",
        "coverage": "jest --config jest.config.cjs --coverage",
        "test:coverage": "jest --config jest.config.cjs --coverage",
        "local": "run-p local:watch local:serve",
        "local:watch": "node build-docs.js && nodemon --exec 'node build-docs.js'",
        "local:serve": "npx netlify dev --offline --no-open --skip-gitignore --dir website --port 8080 --staticServerPort 3998",
        "build": "npm-run-all build:package build:docs",
        "build:package": "rm -rf dist && npm-run-all lint test && tsc --emitDeclarationOnly && node build.js",
        "build:docs": "node build-docs.js",
        "local:serve:en": "npx http-server ./website/en -p 8080",
        "local:serve:zh": "npx http-server ./website/zh -p 8081",
        "local:serve:es": "npx http-server ./website/es -p 8082",
        "local:serve:pt": "npx http-server ./website/pt -p 8083",
        "local:serve:fr": "npx http-server ./website/fr -p 8084"
    },
    "keywords": [
        "web-component",
        "javascript",
        "markup",
        "localization",
        "internationalization",
        "intl",
        "web"
    ],
    "author": "Elson Correia",
    "license": "BSD-3-Clause",
    "repository": {
        "url": "https://github.com/beforesemicolon/intl",
        "type": "git"
    },
    "devDependencies": {
        "@beforesemicolon/builder": "^2.0.1",
        "@beforesemicolon/site-builder": "^1.12.0",
        "@types/jest": "^29.5.1",
        "@types/jsdom": "^21.1.7",
        "@typescript-eslint/eslint-plugin": "^6.7.3",
        "@typescript-eslint/parser": "^6.7.3",
        "esbuild": "^0.28.0",
        "eslint": "^10.0.0",
        "eslint-config-prettier": "^10.0.0",
        "eslint-config-standard": "^17.1.0",
        "eslint-plugin-import": "^2.28.1",
        "eslint-plugin-n": "^16.1.0",
        "eslint-plugin-prettier": "^5.0.0",
        "eslint-plugin-promise": "^6.1.1",
        "http-server": "^14.1.1",
        "jest": "^29.5.0",
        "jest-environment-jsdom": "^29.7.0",
        "jsdom": "^25.0.1",
        "nodemon": "^3.1.14",
        "npm-run-all2": "^5.0.0",
        "prettier": "3.9.6",
        "ts-jest": "^29.1.0",
        "typescript": "^5.7.2"
    },
    "dependencies": {
        "@beforesemicolon/web-component": "^1.21.0",
        "@formatjs/intl-durationformat": "^0.10.0"
    }
}
