{
    "name": "@beforesemicolon/intl",
    "version": "0.1.0",
    "description": "Web component localization based on Markup",
    "type": "module",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js",
            "default": "./dist/cjs/index.js",
            "types": "./dist/types/index.d.ts"
        },
        "./runtime": {
            "import": "./dist/esm/runtime.js",
            "require": "./dist/cjs/runtime.js",
            "default": "./dist/cjs/runtime.js",
            "types": "./dist/types/runtime.d.ts"
        },
        "./formatters": {
            "import": "./dist/esm/formatters.js",
            "require": "./dist/cjs/formatters.js",
            "default": "./dist/cjs/formatters.js",
            "types": "./dist/types/formatters.d.ts"
        },
        "./components/locale": {
            "import": "./dist/esm/components/locale.js",
            "require": "./dist/cjs/components/locale.js",
            "default": "./dist/cjs/components/locale.js",
            "types": "./dist/types/components/locale.d.ts"
        },
        "./components/msg": {
            "import": "./dist/esm/components/msg.js",
            "require": "./dist/cjs/components/msg.js",
            "default": "./dist/cjs/components/msg.js",
            "types": "./dist/types/components/msg.d.ts"
        },
        "./components/number": {
            "import": "./dist/esm/components/number.js",
            "require": "./dist/cjs/components/number.js",
            "default": "./dist/cjs/components/number.js",
            "types": "./dist/types/components/number.d.ts"
        },
        "./components/datetime": {
            "import": "./dist/esm/components/datetime.js",
            "require": "./dist/cjs/components/datetime.js",
            "default": "./dist/cjs/components/datetime.js",
            "types": "./dist/types/components/datetime.d.ts"
        },
        "./components/duration": {
            "import": "./dist/esm/components/duration.js",
            "require": "./dist/cjs/components/duration.js",
            "default": "./dist/cjs/components/duration.js",
            "types": "./dist/types/components/duration.d.ts"
        },
        "./components/relative-time": {
            "import": "./dist/esm/components/relative-time.js",
            "require": "./dist/cjs/components/relative-time.js",
            "default": "./dist/cjs/components/relative-time.js",
            "types": "./dist/types/components/relative-time.d.ts"
        },
        "./components/list": {
            "import": "./dist/esm/components/list.js",
            "require": "./dist/cjs/components/list.js",
            "default": "./dist/cjs/components/list.js",
            "types": "./dist/types/components/list.d.ts"
        },
        "./components/name": {
            "import": "./dist/esm/components/name.js",
            "require": "./dist/cjs/components/name.js",
            "default": "./dist/cjs/components/name.js",
            "types": "./dist/types/components/name.d.ts"
        },
        "./components/plural": {
            "import": "./dist/esm/components/plural.js",
            "require": "./dist/cjs/components/plural.js",
            "default": "./dist/cjs/components/plural.js",
            "types": "./dist/types/components/plural.d.ts"
        }
    },
    "scripts": {
        "lint": "eslint ./src && prettier --check ./src",
        "format": "eslint ./src --fix && prettier --write ./src",
        "test": "jest --config jest.config.cjs --coverage",
        "test:watch": "jest --config jest.config.cjs --watch",
        "coverage": "jest --config jest.config.cjs --coverage",
        "test:coverage": "jest --config jest.config.cjs --coverage",
        "local": "run-p local:watch local:serve",
        "local:watch": "node build-docs.js && nodemon --exec 'node build-docs.js'",
        "local:serve": "npx http-server ./website",
        "build:browser": "node node_modules/@beforesemicolon/builder/dist/esm/build-browser.js",
        "build:modules": "node node_modules/@beforesemicolon/builder/dist/esm/build-modules.js",
        "build": "npm-run-all build:package build:docs",
        "build:package": "rm -rf dist && npm-run-all lint test && tsc --emitDeclarationOnly && npm-run-all build:modules build:browser",
        "build:docs": "node build-docs.js"
    },
    "keywords": [
        "web-component",
        "javascript",
        "markup",
        "localization",
        "internationalization",
        "intl",
        "web"
    ],
    "author": "Elson Correia",
    "license": "BSD-3-Clause",
    "repository": {
        "url": "https://github.com/beforesemicolon/intl",
        "type": "git"
    },
    "devDependencies": {
        "@beforesemicolon/builder": "file:../builder/beforesemicolon-builder-1.8.25.tgz",
        "@types/jest": "^29.5.1",
        "@types/jsdom": "^21.1.7",
        "@typescript-eslint/eslint-plugin": "^6.7.3",
        "@typescript-eslint/parser": "^6.7.3",
        "esbuild": "^0.28.0",
        "eslint": "^8.50.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-config-standard": "^17.1.0",
        "eslint-plugin-import": "^2.28.1",
        "eslint-plugin-n": "^16.1.0",
        "eslint-plugin-prettier": "^5.0.0",
        "eslint-plugin-promise": "^6.1.1",
        "http-server": "^14.1.1",
        "jest": "^29.5.0",
        "jest-environment-jsdom": "^29.7.0",
        "jsdom": "^25.0.1",
        "nodemon": "^3.1.14",
        "npm-run-all": "^4.1.5",
        "prettier": "3.8.3",
        "ts-jest": "^29.1.0",
        "typescript": "^5.7.2"
    },
    "dependencies": {
        "@beforesemicolon/web-component": "^1.16.0",
        "@formatjs/intl-durationformat": "^0.7.1"
    }
}
